@model ERPSystem.WebMVC.ViewModels.Products.ProductIndexPageViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Products";

    var canCreate = Model.CanCreate;
    var canUpdate = Model.CanUpdateOwn || Model.CanUpdateAll;
    var canDelete = Model.CanDeleteOwn || Model.CanDeleteAll;

    var activeTab = ViewBag.ActiveTab as string;
    var productsTabClass = activeTab == "permissions" ? "" : "is-active";
    var permissionsTabClass = activeTab == "permissions" ? "is-active" : "";

    var productCategoryOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Categories.Select(category => new
        {
            value = category.Text,
            text = category.Text
        })
    );
}

<link rel="stylesheet" href="~/css/erp-advanced-filter.css" />

<div class="erp-page">
    <div class="erp-page-header">
        <div>
            <a asp-controller="Workspace" asp-action="Index" class="btn btn-outline-secondary mb-3">
                Apps
            </a>

            <div class="erp-breadcrumb">
                ERP System / Inventory
            </div>

            <h1>Products</h1>
            <p>Manage product records, pricing and inventory information.</p>
        </div>

        @if (canCreate)
        {
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
                New Product
            </a>
        }
    </div>

    <div class="module-tabs">
        <button type="button" class="module-tab @productsTabClass" data-tab-target="productsTab">
            Products
        </button>

        @if (Model.CanViewAccessPermissions)
        {
            <button type="button" class="module-tab @permissionsTabClass" data-tab-target="permissionsTab">
                Access Permissions
            </button>
        }
    </div>

    <div id="productsTab" class="module-tab-panel @productsTabClass">
        <div class="erp-search-shell">
            <div class="erp-search-row">
                <div class="erp-search-input-wrap">
                    <div id="activeFilterChip" class="erp-filter-chip d-none">
                        <span id="activeFilterName"></span>
                        <button type="button" id="clearActiveFilter" title="Clear filter" aria-label="Clear filter">
                            x
                        </button>
                    </div>

                    <input id="quickSearch"
                           class="erp-search-input"
                           type="text"
                           autocomplete="off"
                           placeholder="Search product name, SKU, category, price or date" />
                </div>

                <button type="button" class="erp-view-button is-active" data-view="grid" title="Grid view" aria-label="Grid view">
                    &#9638;
                </button>

                <button type="button" class="erp-view-button" data-view="list" title="List view" aria-label="List view">
                    &#9776;
                </button>
            </div>

            <div id="advancedFilterPopup" class="advanced-filter-popup">
                <div class="advanced-filter-sidebar">
                    <h6>Saved filters</h6>

                    <div id="savedFiltersList" class="saved-filter-list"></div>

                    <div id="saveFilterBox" class="save-filter-box d-none">
                        <label>Filter name</label>
                        <input id="saveFilterNameInput" type="text" />

                        <div class="save-filter-actions">
                            <button id="confirmSaveFilterButton" type="button">
                                Save
                            </button>

                            <button id="cancelSaveFilterButton" type="button">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <button id="saveFilterButton" type="button" class="save-filter-button">
                        + Save filter
                    </button>
                </div>

                <div class="advanced-filter-body">
                    <div id="filterFields" class="filter-fields"></div>

                    <div class="add-field-wrap">
                        <button id="addFieldButton" type="button" class="add-field-button">
                            Add field
                        </button>

                        <button id="restoreDefaultFields" type="button" class="restore-fields-button">
                            Restore default fields
                        </button>
                    </div>

                    <div class="advanced-filter-actions">
                        <button id="applyAdvancedFilter" type="button" class="btn btn-primary">
                            Search
                        </button>

                        <button id="resetAdvancedFilter" type="button" class="btn btn-link">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.CanView)
        {
            <div class="empty-state">
                <h3>No access</h3>
                <p>You do not have permission to view product records.</p>
            </div>
        }
        else if (!Model.Products.Any())
        {
            <div class="empty-state">
                <h3>No products found</h3>
                <p>Create your first product to start managing inventory.</p>
            </div>
        }
        else
        {
            <div id="productsGrid" class="product-grid">
                @foreach (var product in Model.Products)
                {
                    var createdDate = product.CreatedDate.ToString("yyyy-MM-dd");
                    var updatedDate = product.UpdatedDate?.ToString("yyyy-MM-dd") ?? "";

                    <div class="product-item"
                         data-name="@product.Name"
                         data-sku="@product.SKU"
                         data-description="@product.Description"
                         data-category="@product.CategoryName"
                         data-purchaseprice="@product.PurchasePrice"
                         data-saleprice="@product.SalePrice"
                         data-created="@createdDate"
                         data-updated="@updatedDate">

                        <div class="product-card">
                            <div class="product-image">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                }
                                else
                                {
                                    <span>@product.Name.Substring(0, 1).ToUpper()</span>
                                }
                            </div>

                            <div class="product-info">
                                <div class="product-title-row">
                                    <h3>@product.Name</h3>

                                    @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                    {
                                        <span class="product-category">@product.CategoryName</span>
                                    }
                                </div>

                                <div class="product-sku">@product.SKU</div>

                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <p class="product-description">@product.Description</p>
                                }

                                <div class="product-prices">
                                    <div>
                                        <span>Purchase</span>
                                        <strong>@product.PurchasePrice.ToString("0.00")</strong>
                                    </div>

                                    <div>
                                        <span>Sale</span>
                                        <strong>@product.SalePrice.ToString("0.00")</strong>
                                    </div>
                                </div>

                                <div class="product-dates">
                                    Created: @createdDate
                                    @if (!string.IsNullOrWhiteSpace(updatedDate))
                                    {
                                        <span> / Updated: @updatedDate</span>
                                    }
                                </div>
                            </div>

                            @if (canUpdate || canDelete)
                            {
                                <div class="product-menu">
                                    <button type="button" class="product-menu-button" title="Actions" aria-label="Actions">
                                        &#9776;
                                    </button>

                                    <div class="product-menu-dropdown">
                                        @if (canUpdate)
                                        {
                                            <a asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id">
                                                Edit
                                            </a>
                                        }

                                        @if (canDelete)
                                        {
                                            <form asp-controller="Products"
                                                  asp-action="Delete"
                                                  asp-route-id="@product.Id"
                                                  method="post">
                                                <button type="submit">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.CanViewAccessPermissions)
    {
        <div id="permissionsTab" class="module-tab-panel @permissionsTabClass">
            <div class="permission-panel">
                <div class="permission-header">
                    <h2>Access Permissions</h2>
                    <p>Manage who can view, create, update and delete product records.</p>
                </div>

                @if (TempData["PermissionSuccess"] is not null)
                {
                    <div class="alert alert-success">
                        @TempData["PermissionSuccess"]
                    </div>
                }

                @if (TempData["PermissionError"] is not null)
                {
                    <div class="alert alert-danger">
                        @TempData["PermissionError"]
                    </div>
                }

                <form asp-controller="Products" asp-action="Index" method="get" class="permission-user-form">
                    <input type="hidden" name="activeTab" value="permissions" />

                    <div class="permission-user-picker">
                        <label>Select employee/user</label>

                        <button type="button" class="permission-user-trigger" id="permissionUserTrigger">
                            <span id="selectedUserText">
                                @{
                                    var selectedUser = Model.PermissionPage.Users
                                        .FirstOrDefault(user => user.Id == Model.PermissionPage.SelectedUserId);
                                }

                                @if (selectedUser is not null)
                                {
                                    @($"{selectedUser.FullName} ({selectedUser.UserName})")
                                }
                                else
                                {
                                    @("Select user")
                                }
                            </span>

                            <span>v</span>
                        </button>

                        <div class="permission-user-dropdown" id="permissionUserDropdown">
                            <input type="text"
                                   id="permissionUserSearch"
                                   class="form-control permission-user-search"
                                   placeholder="search" />

                            <div class="permission-user-list">
                                @foreach (var user in Model.PermissionPage.Users)
                                {
                                    var initial = string.IsNullOrWhiteSpace(user.FullName)
                                        ? "U"
                                        : user.FullName.Substring(0, 1).ToUpper();

                                    <button type="submit"
                                            name="selectedUserId"
                                            value="@user.Id"
                                            class="permission-user-option"
                                            data-user-search="@($"{user.FullName} {user.UserName} {user.Email}")">
                                        <span class="permission-user-avatar">@initial</span>

                                        <span>
                                            <span class="permission-user-name">@user.FullName</span>
                                            <span class="permission-user-meta">@user.UserName - @user.Email</span>
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.PermissionPage.SelectedUserId))
                {
                    <form asp-controller="Products" asp-action="SavePermissions" method="post">
                        <input type="hidden" name="UserId" value="@Model.PermissionPage.SelectedUserId" />

                        <table class="table table-hover bg-white align-middle permission-table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Access Level</th>
                                    <th>Description</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var permission in Model.PermissionPage.Permissions)
                                {
                                    <tr>
                                        <td>
                                            <strong>@permission.ActionName</strong>
                                            <input type="hidden" name="Permissions.Index" value="@permission.ActionName" />
                                            <input type="hidden" name="Permissions[@permission.ActionName].ActionName" value="@permission.ActionName" />
                                        </td>

                                        <td>
                                            <select name="Permissions[@permission.ActionName].AccessLevel" class="form-select">
                                                <option value="0" selected="@(permission.AccessLevel == 0)">None</option>
                                                <option value="1" selected="@(permission.AccessLevel == 1)">Own records</option>
                                                <option value="2" selected="@(permission.AccessLevel == 2)">All records</option>
                                            </select>
                                        </td>

                                        <td class="text-muted">
                                            @GetPermissionDescription(permission.ActionName)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <button type="submit" class="btn btn-primary">
                            Save Permissions
                        </button>
                    </form>
                }
            </div>
        </div>
    }
</div>

@functions {
    private string GetPermissionDescription(string actionName)
    {
        return actionName switch
        {
            "View" => "Controls whether the user can see product records.",
            "Create" => "Controls whether the user can create new product records.",
            "Update" => "Controls whether the user can edit own or all product records.",
            "Delete" => "Controls whether the user can delete own or all product records.",
            _ => "Controls product module access."
        };
    }
}

@section Scripts {
    <script src="~/js/erp-advanced-filter.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const productCategories = @Html.Raw(productCategoryOptionsJson);

        initializeAdvancedFilter({
        storageKey: "erp_products_saved_filters",
        pinnedStorageKey: "erp_products_pinned_filter",
        quickSearchInputId: "quickSearch",
        advancedFilterPopupId: "advancedFilterPopup",
        filterFieldsId: "filterFields",
        addFieldButtonId: "addFieldButton",
        restoreDefaultFieldsId: "restoreDefaultFields",
        applyButtonId: "applyAdvancedFilter",
        resetButtonId: "resetAdvancedFilter",
        saveFilterButtonId: "saveFilterButton",
        savedFiltersListId: "savedFiltersList",
        activeFilterChipId: "activeFilterChip",
        activeFilterNameId: "activeFilterName",
        clearActiveFilterId: "clearActiveFilter",
        itemSelector: ".product-item",
        defaultFields: ["name", "sku"],
        availableFields: [
        { key: "name", label: "Product Name", type: "text" },
        { key: "sku", label: "SKU", type: "text" },
        { key: "description", label: "Description", type: "text" },
        { key: "category", label: "Category", type: "select", options: productCategories },
        { key: "purchaseprice", label: "Purchase Price", type: "text" },
        { key: "saleprice", label: "Sale Price", type: "text" },
        { key: "created", label: "Created Date", type: "date" },
        { key: "updated", label: "Updated Date", type: "date" }
        ],
        defaultFilterName: "All products",
        fieldSettingsGroupName: "Product"
        });

        document.querySelectorAll(".module-tab").forEach(function (button) {
        button.addEventListener("click", function () {
        document.querySelectorAll(".module-tab").forEach(x => x.classList.remove("is-active"));
        document.querySelectorAll(".module-tab-panel").forEach(x => x.classList.remove("is-active"));

        button.classList.add("is-active");
        document.getElementById(button.dataset.tabTarget).classList.add("is-active");
        });
        });

        document.querySelectorAll(".erp-view-button").forEach(function (button) {
        button.addEventListener("click", function () {
        document.querySelectorAll(".erp-view-button").forEach(x => x.classList.remove("is-active"));
        button.classList.add("is-active");

        const grid = document.getElementById("productsGrid");

        if (!grid) {
        return;
        }

        if (button.dataset.view === "list") {
        grid.classList.add("is-list-view");
        } else {
        grid.classList.remove("is-list-view");
        }
        });
        });

        document.querySelectorAll(".product-menu-button").forEach(function (button) {
        button.addEventListener("click", function (event) {
        event.stopPropagation();

        document.querySelectorAll(".product-menu-dropdown").forEach(function (menu) {
        if (menu !== button.nextElementSibling) {
        menu.classList.remove("is-open");
        }
        });

        button.nextElementSibling.classList.toggle("is-open");
        });
        });

        document.addEventListener("click", function () {
        document.querySelectorAll(".product-menu-dropdown").forEach(function (menu) {
        menu.classList.remove("is-open");
        });
        });

        const permissionUserTrigger = document.getElementById("permissionUserTrigger");
        const permissionUserDropdown = document.getElementById("permissionUserDropdown");
        const permissionUserSearch = document.getElementById("permissionUserSearch");

        permissionUserTrigger?.addEventListener("click", function (event) {
        event.stopPropagation();
        permissionUserDropdown?.classList.toggle("is-open");
        permissionUserSearch?.focus();
        });

        permissionUserDropdown?.addEventListener("click", function (event) {
        event.stopPropagation();
        });

        document.addEventListener("click", function () {
        permissionUserDropdown?.classList.remove("is-open");
        });

        permissionUserSearch?.addEventListener("input", function () {
        const searchValue = permissionUserSearch.value.toLowerCase();

        document.querySelectorAll(".permission-user-option").forEach(function (button) {
        const data = button.dataset.userSearch?.toLowerCase() || "";
        button.style.display = data.includes(searchValue) ? "flex" : "none";
        });
        });
        });
    </script>
}