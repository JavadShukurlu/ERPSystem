@model List<ERPSystem.WebMVC.ViewModels.Products.ProductViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Products";

    var categories = Model
        .Where(product => !string.IsNullOrWhiteSpace(product.CategoryName))
        .Select(product => product.CategoryName)
        .Distinct()
        .OrderBy(category => category)
        .ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Products - ERP Workspace</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f5f6f8;
                color: #1f2937;
            }

            .workspace-topbar {
                height: 58px;
                background: #2f3a45;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 22px;
            }

            .module-page {
                padding: 24px 32px;
            }

            .toolbar {
                background: #fff;
                border: 1px solid #e5e7eb;
                padding: 12px;
                margin-bottom: 18px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .search-box {
                max-width: 480px;
                flex: 1;
            }

            .view-button {
                width: 38px;
                height: 38px;
                border: 1px solid #d1d5db;
                background: #fff;
                font-weight: 700;
            }

                .view-button.active {
                    background: #111827;
                    color: #fff;
                    border-color: #111827;
                }

            .product-card {
                background: #fff;
                border: 1px solid #e5e7eb;
                min-height: 210px;
                transition: box-shadow .15s ease, transform .15s ease;
                position: relative;
            }

                .product-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 24px rgba(15,23,42,.08);
                }

            .product-image {
                width: 96px;
                height: 96px;
                object-fit: cover;
                background: #f3f4f6;
                border: 1px solid #e5e7eb;
            }

            .product-placeholder {
                width: 96px;
                height: 96px;
                background: #f3f4f6;
                border: 1px solid #e5e7eb;
                color: #9ca3af;
                font-size: 13px;
            }

            .metric-label {
                color: #6b7280;
                font-size: 12px;
            }

            .metric-value {
                font-weight: 700;
                color: #111827;
            }

            .product-actions {
                position: absolute;
                top: 12px;
                right: 12px;
            }

            .action-menu-button {
                width: 34px;
                height: 34px;
                border: 1px solid #d1d5db;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .list-view .product-item {
                width: 100%;
            }

            .list-view .product-card {
                min-height: auto;
            }

            .list-view .product-content {
                align-items: center;
            }

            .list-view .product-description {
                display: none;
            }

            .empty-state {
                background: #fff;
                border: 1px solid #e5e7eb;
                padding: 40px;
                text-align: center;
            }

            .date-line {
                color: #6b7280;
                font-size: 12px;
            }
    </style>
</head>
<body>
    <header class="workspace-topbar">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Workspace" asp-action="Index" class="btn btn-sm btn-outline-light">Apps</a>
            <strong>ERP System / Inventory</strong>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary">New Product</a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-light">Logout</a>
        </div>
    </header>

    <main class="module-page">
        <div class="mb-4">
            <div class="text-muted small">Workspace / Inventory</div>
            <h1 class="mb-0">Products</h1>
        </div>

        <div class="toolbar">
            <div class="input-group search-box">
                <span class="input-group-text bg-white">Search</span>
                <input id="productSearch" type="text" class="form-control" placeholder="Search products, date, SKU, category, price or stock" />
            </div>

            <div class="d-flex align-items-center gap-2">
                <select id="categoryFilter" class="form-select" style="width:220px;">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>

                <button id="kanbanButton" type="button" class="view-button active" title="Kanban view">▦</button>
                <button id="listButton" type="button" class="view-button" title="List view">☰</button>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h4>No products found</h4>
                <p class="text-muted mb-3">Create your first product to start inventory management.</p>
                <a asp-controller="Products" asp-action="Create" class="btn btn-primary">New Product</a>
            </div>
        }
        else
        {
            <div id="productsGrid" class="row g-3">
                @foreach (var product in Model)
                {
                    var createdText = product.CreatedDate.ToString("dd MMM yyyy HH:mm");
                    var updatedText = product.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "";

                    <div class="col-md-6 col-xl-4 product-item"
                         data-category="@product.CategoryName"
                         data-search="@($"{product.Name} {product.SKU} {product.Description} {product.CategoryName} {product.PurchasePrice} {product.SalePrice} {product.StockQuantity} {createdText} {updatedText}")">
                        <div class="product-card p-3">
                            <div class="dropdown product-actions">
                                <button class="action-menu-button" type="button" data-bs-toggle="dropdown">☰</button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                                    </li>
                                    <li>
                                        <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="dropdown-item text-danger">Delete</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                            <div class="product-content d-flex gap-3 pe-4">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                                }
                                else
                                {
                                    <div class="product-placeholder d-flex align-items-center justify-content-center">No image</div>
                                }

                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                        <div>
                                            <h5 class="mb-1">@product.Name</h5>
                                            <div class="text-muted small">@product.SKU</div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                                        {
                                            <span class="badge bg-secondary">@product.CategoryName</span>
                                        }
                                    </div>

                                    <p class="product-description text-muted small mt-2 mb-3">@product.Description</p>

                                    <div class="row g-2 mb-2">
                                        <div class="col-4">
                                            <div class="metric-label">Cost</div>
                                            <div class="metric-value">@product.PurchasePrice.ToString("0.00")</div>
                                        </div>

                                        <div class="col-4">
                                            <div class="metric-label">Sale</div>
                                            <div class="metric-value">@product.SalePrice.ToString("0.00")</div>
                                        </div>

                                        <div class="col-4">
                                            <div class="metric-label">Stock</div>
                                            @if (product.StockQuantity <= 0)
                                            {
                                                <span class="badge bg-danger">Out</span>
                                            }
                                            else if (product.StockQuantity <= 5)
                                            {
                                                <span class="badge bg-warning text-dark">@product.StockQuantity Low</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@product.StockQuantity In Stock</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="date-line">Created: @createdText</div>

                                    @if (product.UpdatedDate is not null)
                                    {
                                        <div class="date-line">Updated: @updatedText</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const searchInput = document.getElementById("productSearch");
        const categoryFilter = document.getElementById("categoryFilter");
        const productItems = document.querySelectorAll(".product-item");
        const productsGrid = document.getElementById("productsGrid");
        const kanbanButton = document.getElementById("kanbanButton");
        const listButton = document.getElementById("listButton");

        function filterProducts() {
        const searchValue = searchInput.value.toLowerCase().trim();
        const categoryValue = categoryFilter.value.toLowerCase();

        productItems.forEach(item => {
        const searchableText = (item.dataset.search || "").toLowerCase();
        const category = (item.dataset.category || "").toLowerCase();

        const matchesSearch = searchableText.includes(searchValue);
        const matchesCategory = !categoryValue || category === categoryValue;

        item.style.display = matchesSearch && matchesCategory ? "" : "none";
        });
        }

        function setKanbanView() {
        productsGrid.classList.remove("list-view");

        productItems.forEach(item => {
        item.classList.remove("col-12");
        item.classList.add("col-md-6", "col-xl-4");
        });

        kanbanButton.classList.add("active");
        listButton.classList.remove("active");
        }

        function setListView() {
        productsGrid.classList.add("list-view");

        productItems.forEach(item => {
        item.classList.remove("col-md-6", "col-xl-4");
        item.classList.add("col-12");
        });

        listButton.classList.add("active");
        kanbanButton.classList.remove("active");
        }

        searchInput.addEventListener("input", filterProducts);
        categoryFilter.addEventListener("change", filterProducts);
        kanbanButton.addEventListener("click", setKanbanView);
        listButton.addEventListener("click", setListView);
    </script>
</body>
</html>