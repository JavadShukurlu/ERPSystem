@model ERPSystem.WebMVC.ViewModels.Products.CreateProductViewModel

@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Create Product";
}

<h3 class="mb-3">Create Product</h3>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Create" method="post" class="bg-white p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">SKU</label>
        <input asp-for="SKU" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Purchase Price</label>
        <input asp-for="PurchasePrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Sale Price</label>
        <input asp-for="SalePrice" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>