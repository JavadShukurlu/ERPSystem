@model ERPSystem.WebMVC.ViewModels.Dashboard.AdminDashboardViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">Admin Dashboard</h2>
    <p class="text-muted mb-0">System overview, activity and important metrics.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="bg-white p-3 shadow-sm border-start border-primary border-4">
            <div class="text-muted small">Products</div>
            <h3 class="mb-0">@Model.TotalProducts</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="bg-white p-3 shadow-sm border-start border-success border-4">
            <div class="text-muted small">Customers</div>
            <h3 class="mb-0">@Model.TotalCustomers</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="bg-white p-3 shadow-sm border-start border-warning border-4">
            <div class="text-muted small">Suppliers</div>
            <h3 class="mb-0">@Model.TotalSuppliers</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="bg-white p-3 shadow-sm border-start border-info border-4">
            <div class="text-muted small">Employees</div>
            <h3 class="mb-0">@Model.TotalEmployees</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="bg-white p-3 shadow-sm border-start border-danger border-4">
            <div class="text-muted small">Low Stock</div>
            <h3 class="mb-0">@Model.LowStockCount</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="bg-white p-3 shadow-sm border-start border-primary border-4">
            <div class="text-muted small">Sales Total</div>
            <h3 class="mb-0">@Model.TotalSalesAmount.ToString("0.00")</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="bg-white p-3 shadow-sm border-start border-warning border-4">
            <div class="text-muted small">Purchase Total</div>
            <h3 class="mb-0">@Model.TotalPurchaseAmount.ToString("0.00")</h3>
        </div>
    </div>
</div>

<div class="bg-white p-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Recent Audit Logs</h4>

        <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-outline-primary">
            View All
        </a>
    </div>

    @if (!Model.RecentAuditLogs.Any())
    {
        <div class="alert alert-info mb-0">
            No recent audit logs found.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.RecentAuditLogs)
                {
                    var badgeClass = log.Action switch
                    {
                        "Created" => "bg-success",
                        "Updated" => "bg-warning text-dark",
                        "Deleted" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>@log.ActionDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@log.UserId</td>
                        <td>
                            <span class="badge @badgeClass">
                                @log.Action
                            </span>
                        </td>
                        <td>@log.EntityName</td>
                        <td>@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>