@{
    Layout = null;
    ViewData["Title"] = "Workspace";

    var userName = Context.Session.GetString("UserName") ?? "User";

    var modules = new[]
    {
        new
        {
            Title = "Inventory",
            Subtitle = "Products, stocks and warehouses",
            Area = "",
            Controller = "Products",
            Action = "Index",
            Icon = "📦",
            Color = "#2563eb"
        },
        new
        {
            Title = "Customers",
            Subtitle = "Customer profiles and sales contacts",
            Area = "",
            Controller = "Customers",
            Action = "Index",
            Icon = "👥",
            Color = "#0f766e"
        },
        new
        {
            Title = "Sales",
            Subtitle = "Sales orders and customer invoices",
            Area = "",
            Controller = "Sales",
            Action = "Index",
            Icon = "🧾",
            Color = "#16a34a"
        },
        new
        {
            Title = "Purchases",
            Subtitle = "Suppliers and purchase orders",
            Area = "",
            Controller = "Purchases",
            Action = "Index",
            Icon = "🛒",
            Color = "#f59e0b"
        },
        new
        {
            Title = "Finance",
            Subtitle = "Invoices, payments and reports",
            Area = "",
            Controller = "Invoices",
            Action = "Index",
            Icon = "💳",
            Color = "#7c3aed"
        },
        new
        {
            Title = "Apps",
            Subtitle = "Marketplace and custom modules",
            Area = "",
            Controller = "Apps",
            Action = "Index",
            Icon = "🧩",
            Color = "#0891b2"
        },
        new
        {
            Title = "Reports",
            Subtitle = "Dashboard and business analytics",
            Area = "",
            Controller = "Reports",
            Action = "Index",
            Icon = "📊",
            Color = "#dc2626"
        },
        new
        {
            Title = "Admin Panel",
            Subtitle = "System management and audit logs",
            Area = "Admin",
            Controller = "Dashboard",
            Action = "Index",
            Icon = "⚙️",
            Color = "#111827"
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ERP Workspace</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #f4f7fb 0%, #eef2ff 45%, #f8fafc 100%);
            }

            .topbar {
                height: 64px;
                background: #222831;
                color: white;
            }

            .app-tile {
                border-radius: 16px;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }

                .app-tile:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.15) !important;
                }

            .app-icon {
                width: 72px;
                height: 72px;
                border-radius: 18px;
                color: white;
                font-size: 34px;
            }
    </style>
</head>
<body>
    <header class="topbar d-flex align-items-center justify-content-between px-4">
        <div class="d-flex align-items-center gap-3">
            <strong>ERP System</strong>
            <span class="text-white-50">Workspace</span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50">Welcome, @userName</span>

            <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-light">
                Logout
            </a>
        </div>
    </header>

    <main class="container py-5">
        <div class="mb-5">
            <h1 class="mb-2">ERP Workspace</h1>
            <p class="text-muted mb-0">Choose a module to manage business operations.</p>
        </div>

        <div class="row g-4">
            @foreach (var module in modules)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-area="@module.Area"
                       asp-controller="@module.Controller"
                       asp-action="@module.Action"
                       class="text-decoration-none">
                        <div class="app-tile bg-white shadow-sm h-100 p-4 text-center">
                            <div class="app-icon mx-auto mb-3 d-flex align-items-center justify-content-center"
                                 style="background:@module.Color;">
                                @module.Icon
                            </div>

                            <h5 class="text-dark mb-1">@module.Title</h5>
                            <p class="text-muted small mb-0">@module.Subtitle</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>