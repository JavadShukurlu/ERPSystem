@{
    ViewData["Title"] = "Admin Panel";
}

<h3 class="mb-3">Admin Panel</h3>

<div class="row g-3">
    <div class="col-md-3">
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5>Products</h5>
                    <p class="text-muted mb-0">Manage product data</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Reports" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5>Reports</h5>
                    <p class="text-muted mb-0">System statistics</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="AuditLogs" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5>Audit Logs</h5>
                    <p class="text-muted mb-0">Track system actions</p>
                </div>
            </div>
        </a>
    </div>
</div>