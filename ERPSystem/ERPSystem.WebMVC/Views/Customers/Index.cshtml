@model ERPSystem.WebMVC.ViewModels.Customers.CustomerIndexPageViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Customers";

    var activeTab = ViewBag.ActiveTab as string;
    var showPermissionsTab = activeTab == "permissions";

    var selectedUser = Model.PermissionPage.Users
        .FirstOrDefault(user => user.Id == Model.PermissionPage.SelectedUserId);
}

<div class="erp-topbar">
    <div class="erp-topbar-left">
        <a asp-controller="Workspace" asp-action="Index" class="btn btn-outline-secondary">
            Apps
        </a>
    </div>

    <div class="erp-topbar-title">ERP System</div>
</div>

<div class="erp-page">
    <div class="erp-page-header">
        <div>
            <div class="erp-breadcrumb">Workspace / Customers</div>
            <h1>Customers</h1>
            <p>Manage customer records and contact information.</p>
        </div>

        @if (Model.CanCreate)
        {
            <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
                New Customer
            </a>
        }
    </div>

    <div class="module-tabs">
        <button type="button"
                class="module-tab @(showPermissionsTab ? "" : "is-active")"
                data-tab-target="customersTab">
            Customers
        </button>

        @if (Model.CanViewAccessPermissions)
        {
            <button type="button"
                    class="module-tab @(showPermissionsTab ? "is-active" : "")"
                    data-tab-target="permissionsTab">
                Access Permissions
            </button>
        }
    </div>

    <div id="customersTab" class="module-tab-panel @(showPermissionsTab ? "" : "is-active")">
        @if (!Model.CanView)
        {
            <div class="alert alert-warning mt-3">
                You do not have permission to view customer records.
            </div>
        }
        else
        {
            <div class="erp-search-shell">
                <div class="erp-search-row">
                    <div class="erp-search-input-wrap">
                        <div id="activeFilterChip" class="erp-filter-chip d-none">
                            <span id="activeFilterName"></span>
                            <button type="button" id="clearActiveFilter">x</button>
                        </div>

                        <input type="text"
                               id="quickSearch"
                               class="erp-search-input"
                               placeholder="Search customer name, email, phone, address or date"
                               autocomplete="off" />
                    </div>

                    <button type="button" class="erp-view-button is-active" data-view-mode="kanban" title="Grid view">
                        &#9638;
                    </button>

                    <button type="button" class="erp-view-button" data-view-mode="list" title="List view">
                        &#9776;
                    </button>
                </div>

                <div class="advanced-filter-popup" id="advancedFilterPopup">
                    <div class="advanced-filter-sidebar">
                        <h6>Saved filters</h6>

                        <div id="savedFiltersList" class="saved-filter-list"></div>

                        <div id="saveFilterBox" class="save-filter-box d-none">
                            <label>Filter name</label>

                            <input type="text"
                                   id="saveFilterNameInput"
                                   placeholder="Filter name" />

                            <div class="save-filter-actions">
                                <button type="button" id="confirmSaveFilterButton">
                                    Save
                                </button>

                                <button type="button" id="cancelSaveFilterButton">
                                    Cancel
                                </button>
                            </div>
                        </div>

                        <button type="button" id="saveFilterButton" class="save-filter-button">
                            + Save filter
                        </button>
                    </div>

                    <div class="advanced-filter-body">
                        <div id="filterFields" class="filter-fields"></div>

                        <div class="add-field-wrap">
                            <button type="button" id="addFieldButton" class="add-field-button">
                                Add field
                            </button>

                            <button type="button" id="restoreDefaultFields" class="restore-fields-button">
                                Restore default fields
                            </button>

                            <div id="fieldPicker" class="field-picker"></div>
                        </div>

                        <div class="advanced-filter-actions">
                            <button type="button" id="applyAdvancedFilter" class="btn btn-primary">
                                Search
                            </button>

                            <button type="button" id="resetAdvancedFilter" class="btn btn-link">
                                Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.Customers.Any())
            {
                <div class="alert alert-info mt-3">No customers found.</div>
            }
            else
            {
                <div id="customerList" class="customer-grid">
                    @foreach (var customer in Model.Customers)
                    {
                        var createdDate = customer.CreatedDate.ToString("yyyy-MM-dd");
                        var updatedDate = customer.UpdatedDate?.ToString("yyyy-MM-dd") ?? "";

                        var canUpdateThisCustomer =
                            Model.IsAdmin ||
                            Model.CanUpdateAll ||
                            (Model.CanUpdateOwn && customer.CreatedByUserId == Model.CurrentUserId);

                        var canDeleteThisCustomer =
                            Model.IsAdmin ||
                            Model.CanDeleteAll ||
                            (Model.CanDeleteOwn && customer.CreatedByUserId == Model.CurrentUserId);

                        <div class="customer-item"
                             data-fullname="@customer.FullName"
                             data-email="@customer.Email"
                             data-phone="@customer.PhoneNumber"
                             data-address="@customer.Address"
                             data-created="@createdDate"
                             data-updated="@updatedDate">
                            <div class="customer-card">
                                <div class="customer-avatar">
                                    @if (!string.IsNullOrWhiteSpace(customer.ImageUrl))
                                    {
                                        <img src="@customer.ImageUrl" alt="@customer.FullName" />
                                    }
                                    else
                                    {
                                        <span>@customer.FullName.Substring(0, 1).ToUpper()</span>
                                    }
                                </div>

                                <div class="customer-info">
                                    <h3>@customer.FullName</h3>
                                    <p>@customer.Email</p>
                                    <p>@customer.PhoneNumber</p>
                                    <p>@customer.Address</p>

                                    <div class="customer-dates">
                                        Created: @createdDate
                                        @if (!string.IsNullOrWhiteSpace(updatedDate))
                                        {
                                            <span>/ Updated: @updatedDate</span>
                                        }
                                    </div>
                                </div>

                                @if (canUpdateThisCustomer || canDeleteThisCustomer)
                                {
                                    <div class="customer-menu">
                                        <button type="button" class="customer-menu-button" title="Actions">
                                            &#9776;
                                        </button>

                                        <div class="customer-menu-dropdown">
                                            @if (canUpdateThisCustomer)
                                            {
                                                <a asp-controller="Customers"
                                                   asp-action="Edit"
                                                   asp-route-id="@customer.Id">
                                                    Edit
                                                </a>
                                            }

                                            @if (canDeleteThisCustomer)
                                            {
                                                <form asp-controller="Customers"
                                                      asp-action="Delete"
                                                      asp-route-id="@customer.Id"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit">Delete</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (Model.CanViewAccessPermissions)
    {
        <div id="permissionsTab" class="module-tab-panel @(showPermissionsTab ? "is-active" : "")">
            <div class="permission-panel">
                <div class="permission-header">
                    <h2>Access Permissions</h2>
                    <p>Manage who can view, create, update and delete customer records.</p>
                </div>

                <form asp-controller="Customers"
                      asp-action="Index"
                      method="get"
                      id="permissionUserForm"
                      class="permission-user-form">
                    <input type="hidden" name="activeTab" value="permissions" />

                    <div class="permission-user-picker">
                        <label class="form-label">Select employee/user</label>

                        <input type="hidden"
                               id="selectedPermissionUserId"
                               name="selectedUserId"
                               value="@Model.PermissionPage.SelectedUserId" />

                        <button type="button"
                                class="permission-user-trigger"
                                id="permissionUserTrigger">
                            @if (selectedUser is not null)
                            {
                                <span>@selectedUser.FullName (@selectedUser.UserName)</span>
                            }
                            else
                            {
                                <span>Select employee/user</span>
                            }

                            <span>v</span>
                        </button>

                        <div class="permission-user-dropdown" id="permissionUserDropdown">
                            <input type="text"
                                   id="permissionUserSearch"
                                   class="form-control permission-user-search"
                                   placeholder="search" />

                            <div class="permission-user-list">
                                @foreach (var user in Model.PermissionPage.Users)
                                {
                                    <button type="button"
                                            class="permission-user-option"
                                            data-user-id="@user.Id"
                                            data-user-label="@user.FullName (@user.UserName)"
                                            data-search="@($"{user.FullName} {user.UserName} {user.Email}".ToLower())">
                                        <div class="permission-user-avatar">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>

                                        <div>
                                            <div class="permission-user-name">@user.FullName</div>
                                            <div class="permission-user-meta">@user.UserName - @user.Email</div>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.PermissionPage.SelectedUserId))
                {
                    <form asp-controller="Customers"
                          asp-action="SavePermissions"
                          method="post"
                          class="permission-save-form">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="UserId" value="@Model.PermissionPage.SelectedUserId" />
                        <input type="hidden" name="ModuleName" value="Customers" />

                        <table class="table permission-table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Access Level</th>
                                    <th>Description</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (var i = 0; i < Model.PermissionPage.Actions.Count; i++)
                                {
                                    var actionName = Model.PermissionPage.Actions[i];

                                    var permission = Model.PermissionPage.Permissions
                                        .FirstOrDefault(permission => permission.ActionName == actionName);

                                    var accessLevel = permission?.AccessLevel ?? 0;

                                    <tr>
                                        <td>
                                            <strong>@actionName</strong>

                                            <input type="hidden" name="Permissions[@i].UserId" value="@Model.PermissionPage.SelectedUserId" />
                                            <input type="hidden" name="Permissions[@i].ModuleName" value="Customers" />
                                            <input type="hidden" name="Permissions[@i].ActionName" value="@actionName" />
                                        </td>

                                        <td>
                                            <select name="Permissions[@i].AccessLevel" class="form-select">
                                                @if (accessLevel == 0)
                                                {
                                                    <option value="0" selected>None</option>
                                                }
                                                else
                                                {
                                                    <option value="0">None</option>
                                                }

                                                @if (actionName == "Create")
                                                {
                                                    if (accessLevel == 2)
                                                    {
                                                        <option value="2" selected>Allowed</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="2">Allowed</option>
                                                    }
                                                }
                                                else
                                                {
                                                    if (accessLevel == 1)
                                                    {
                                                        <option value="1" selected>Own records</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="1">Own records</option>
                                                    }

                                                    if (accessLevel == 2)
                                                    {
                                                        <option value="2" selected>All records</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="2">All records</option>
                                                    }
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            @if (actionName == "View")
                                            {
                                                <span>Controls whether the user can see customer records.</span>
                                            }
                                            else if (actionName == "Create")
                                            {
                                                <span>Controls whether the user can create new customer records.</span>
                                            }
                                            else if (actionName == "Update")
                                            {
                                                <span>Controls whether the user can edit own or all customer records.</span>
                                            }
                                            else if (actionName == "Delete")
                                            {
                                                <span>Controls whether the user can delete own or all customer records.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <button type="submit" class="btn btn-primary">
                            Save Permissions
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info">Select a user to manage permissions.</div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/erp-advanced-filter.js"></script>

    <script>
        document.querySelectorAll(".module-tab").forEach(tab => {
        tab.addEventListener("click", function () {
        document.querySelectorAll(".module-tab").forEach(item => item.classList.remove("is-active"));
        document.querySelectorAll(".module-tab-panel").forEach(item => item.classList.remove("is-active"));

        this.classList.add("is-active");
        document.getElementById(this.dataset.tabTarget)?.classList.add("is-active");
        });
        });

        document.querySelectorAll(".customer-menu-button").forEach(button => {
        button.addEventListener("click", function (event) {
        event.stopPropagation();

        document.querySelectorAll(".customer-menu-dropdown").forEach(dropdown => {
        if (dropdown !== this.nextElementSibling) {
        dropdown.classList.remove("is-open");
        }
        });

        this.nextElementSibling.classList.toggle("is-open");
        });
        });

        document.addEventListener("click", function () {
        document.querySelectorAll(".customer-menu-dropdown").forEach(dropdown => {
        dropdown.classList.remove("is-open");
        });
        });

        if (document.getElementById("quickSearch")) {
        initializeAdvancedFilter({
        storageKey: "erp_customers_saved_filters",
        pinnedStorageKey: "erp_customers_pinned_filter",
        quickSearchInputId: "quickSearch",
        advancedFilterPopupId: "advancedFilterPopup",
        filterFieldsId: "filterFields",
        addFieldButtonId: "addFieldButton",
        fieldPickerId: "fieldPicker",
        restoreDefaultFieldsId: "restoreDefaultFields",
        applyButtonId: "applyAdvancedFilter",
        resetButtonId: "resetAdvancedFilter",
        saveFilterButtonId: "saveFilterButton",
        savedFiltersListId: "savedFiltersList",
        activeFilterChipId: "activeFilterChip",
        activeFilterNameId: "activeFilterName",
        clearActiveFilterId: "clearActiveFilter",
        itemSelector: ".customer-item",
        defaultFields: ["fullname", "email"],
        availableFields: [
        { key: "fullname", label: "Full Name", type: "text" },
        { key: "email", label: "Email", type: "text" },
        { key: "phone", label: "Phone", type: "text" },
        { key: "address", label: "Address", type: "text" },
        { key: "created", label: "Created Date", type: "date" },
        { key: "updated", label: "Updated Date", type: "date" }
        ]
        });
        }

        document.querySelectorAll("[data-view-mode]").forEach(button => {
        button.addEventListener("click", function () {
        document.querySelectorAll("[data-view-mode]").forEach(item => item.classList.remove("is-active"));
        this.classList.add("is-active");

        const customerList = document.getElementById("customerList");

        if (this.dataset.viewMode === "list") {
        customerList?.classList.add("is-list-view");
        } else {
        customerList?.classList.remove("is-list-view");
        }
        });
        });

        const permissionUserTrigger = document.getElementById("permissionUserTrigger");
        const permissionUserDropdown = document.getElementById("permissionUserDropdown");
        const permissionUserSearch = document.getElementById("permissionUserSearch");
        const selectedPermissionUserId = document.getElementById("selectedPermissionUserId");
        const permissionUserForm = document.getElementById("permissionUserForm");

        permissionUserTrigger?.addEventListener("click", function () {
        permissionUserDropdown.classList.toggle("is-open");
        permissionUserSearch?.focus();
        });

        permissionUserSearch?.addEventListener("input", function () {
        const searchValue = this.value.toLowerCase();
        const options = document.querySelectorAll(".permission-user-option");

        options.forEach(option => {
        const searchableText = option.dataset.search || "";
        option.style.display = searchableText.includes(searchValue) ? "flex" : "none";
        });
        });

        document.querySelectorAll(".permission-user-option").forEach(option => {
        option.addEventListener("click", function () {
        selectedPermissionUserId.value = this.dataset.userId;
        permissionUserTrigger.querySelector("span").textContent = this.dataset.userLabel;
        permissionUserDropdown.classList.remove("is-open");
        permissionUserForm.submit();
        });
        });

        document.addEventListener("click", function (event) {
        if (!event.target.closest(".permission-user-picker")) {
        permissionUserDropdown?.classList.remove("is-open");
        }
        });
    </script>
}