@model ERPSystem.WebMVC.ViewModels.Customers.CustomerIndexPageViewModel

@{
    Layout = null;
    ViewData["Title"] = "Customers";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Customers - ERP System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/erp-advanced-filter.css" rel="stylesheet" />

    <style>
            body {
                background: #f5f6f8;
                color: #111827;
            }

            .erp-topbar {
                height: 58px;
                background: #ffffff;
                border-bottom: 1px solid #dde2ea;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 28px;
            }

            .erp-shell {
                padding: 24px 32px;
            }

            .page-heading {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 18px;
            }

            .page-title {
                font-size: 34px;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .breadcrumb-text {
                color: #6b7280;
                font-size: 15px;
                margin-bottom: 4px;
            }

            .module-tabs {
                display: flex;
                gap: 6px;
                margin-top: 18px;
                border-bottom: 1px solid #dde2ea;
            }

            .module-tab {
                border: 0;
                background: transparent;
                padding: 10px 14px;
                color: #6b7280;
            }

                .module-tab.active {
                    color: #111827;
                    border-bottom: 2px solid #0d6efd;
                    font-weight: 600;
                }

            .tab-content-panel {
                display: none;
            }

                .tab-content-panel.active {
                    display: block;
                }

            .customer-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
                gap: 16px;
            }

            .customer-card {
                background: #ffffff;
                border: 1px solid #dde2ea;
                padding: 16px;
                display: grid;
                grid-template-columns: 82px 1fr auto;
                gap: 14px;
                align-items: start;
                position: relative;
            }

            .customer-image {
                width: 82px;
                height: 82px;
                object-fit: cover;
                border-radius: 50%;
                background: #eef1f5;
            }

            .customer-placeholder {
                width: 82px;
                height: 82px;
                border-radius: 50%;
                background: #eef1f5;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6b7280;
                font-weight: 600;
            }

            .customer-name {
                font-size: 21px;
                font-weight: 600;
                margin-bottom: 4px;
            }

            .muted-text {
                color: #6b7280;
            }

            .date-row {
                font-size: 13px;
                color: #6b7280;
                margin-top: 8px;
            }

            .menu-button {
                border: 1px solid #cfd6df;
                background: #ffffff;
                width: 34px;
                height: 34px;
            }

            .customer-menu {
                display: none;
                position: absolute;
                right: 16px;
                top: 52px;
                background: #ffffff;
                border: 1px solid #dde2ea;
                min-width: 130px;
                z-index: 10;
                box-shadow: 0 10px 30px rgba(15, 23, 42, .12);
            }

                .customer-menu a,
                .customer-menu button {
                    display: block;
                    width: 100%;
                    border: 0;
                    background: transparent;
                    padding: 9px 12px;
                    text-align: left;
                    text-decoration: none;
                    color: #111827;
                }

                .customer-menu button {
                    color: #dc3545;
                }

            .list-view .customer-grid {
                display: block;
            }

            .list-view .customer-card {
                margin-bottom: 10px;
                grid-template-columns: 58px 1fr auto;
            }

            .list-view .customer-image,
            .list-view .customer-placeholder {
                width: 58px;
                height: 58px;
            }

            .permission-panel {
                background: #ffffff;
                border: 1px solid #dde2ea;
                padding: 18px;
                margin-top: 18px;
            }
    </style>
</head>

<body>
    <header class="erp-topbar">
        <a asp-controller="Workspace" asp-action="Index" class="btn btn-outline-secondary">
            Apps
        </a>

        <strong>ERP System</strong>
    </header>

    <main class="erp-shell" id="customerPage">
        <div class="breadcrumb-text">Workspace / Customers</div>

        <div class="page-heading">
            <div>
                <h1 class="page-title">Customers</h1>
                <p class="text-muted mb-0">Manage customer records and contact information.</p>
            </div>

            @if (Model.CanCreate)
            {
                <a asp-controller="Customers" asp-action="Create" class="btn btn-primary">
                    New Customer
                </a>
            }
        </div>

        <div class="module-tabs">
            <button type="button" class="module-tab active" data-tab-target="customersTab">
                Customers
            </button>

            @if (Model.CanViewAccessPermissions)
            {
                <button type="button" class="module-tab" data-tab-target="permissionsTab">
                    Access Permissions
                </button>
            }
        </div>

        <section id="customersTab" class="tab-content-panel active">
            <div class="search-area">
                <div class="search-toolbar">
                    <div class="search-box">
                        <span class="search-label">Search</span>

                        <div class="search-input-wrapper">
                            <div id="activeFilterChip" class="active-filter-chip" style="display:none;">
                                <span id="activeFilterName"></span>
                                <button type="button" id="clearActiveFilterButton">x</button>
                            </div>

                            <input id="quickSearch"
                                   class="search-input filter-input"
                                   placeholder="Search customer name, email, phone, address or date" />
                        </div>
                    </div>

                    <button type="button" id="kanbanButton" class="btn btn-dark">
                        ▦
                    </button>

                    <button type="button" id="listButton" class="btn btn-outline-secondary">
                        ☰
                    </button>
                </div>

                <div id="filterPopup" class="filter-popup">
                    <aside class="filter-popup-sidebar">
                        <div class="saved-filter-title">Saved filters</div>

                        <div id="savedFiltersList" class="saved-filter-list"></div>

                        <button type="button" id="saveFilterButton" class="save-filter-button">
                            + Save filter
                        </button>
                    </aside>

                    <section class="filter-popup-body">
                        <div class="filter-grid">
                            <div class="filter-field">
                                <label>Full Name</label>
                                <input id="filterFullName" class="form-control filter-input" />
                            </div>

                            <div class="filter-field">
                                <label>Email</label>
                                <input id="filterEmail" class="form-control filter-input" />
                            </div>

                            <div class="filter-field">
                                <label>Phone</label>
                                <input id="filterPhone" class="form-control filter-input" />
                            </div>

                            <div class="filter-field optional-filter" data-filter-field="address" style="display:none;">
                                <label>Address</label>
                                <input id="filterAddress" class="form-control filter-input" />
                            </div>

                            <div class="filter-field optional-filter" data-filter-field="created" style="display:none;">
                                <label>Created Date</label>
                                <input id="filterCreated" type="date" class="form-control filter-input" />
                            </div>

                            <div class="filter-field optional-filter" data-filter-field="updated" style="display:none;">
                                <label>Updated Date</label>
                                <input id="filterUpdated" type="date" class="form-control filter-input" />
                            </div>
                        </div>

                        <div class="filter-actions">
                            <div class="add-field-wrapper">
                                <button type="button" id="addFieldButton" class="btn btn-link px-0">
                                    Add field
                                </button>

                                <div id="addFieldMenu" class="add-field-menu">
                                    <label>
                                        <input type="checkbox" class="field-choice" value="address" />
                                        Address
                                    </label>

                                    <label>
                                        <input type="checkbox" class="field-choice" value="created" />
                                        Created Date
                                    </label>

                                    <label>
                                        <input type="checkbox" class="field-choice" value="updated" />
                                        Updated Date
                                    </label>
                                </div>
                            </div>

                            <button type="button" id="restoreFiltersButton" class="restore-button text-muted">
                                Restore default fields
                            </button>
                        </div>

                        <div class="filter-submit-actions">
                            <button type="button" id="searchButton" class="btn btn-primary px-4">
                                Search
                            </button>

                            <button type="button" id="resetButton" class="btn btn-link text-muted">
                                Reset
                            </button>
                        </div>
                    </section>
                </div>
            </div>

            @if (!Model.Customers.Any())
            {
                <div class="alert alert-info">
                    No customers found.
                </div>
            }
            else
            {
                <div class="customer-grid">
                    @foreach (var customer in Model.Customers)
                    {
                        var createdText = customer.CreatedDate.ToString("yyyy-MM-dd");
                        var updatedText = customer.UpdatedDate.HasValue
                            ? customer.UpdatedDate.Value.ToString("yyyy-MM-dd")
                            : "";

                        var canUpdateThisCustomer =
                            Model.IsAdmin ||
                            Model.CanUpdateAll ||
                            (Model.CanUpdateOwn && customer.CreatedByUserId == Model.CurrentUserId);

                        var canDeleteThisCustomer =
                            Model.IsAdmin ||
                            Model.CanDeleteAll ||
                            (Model.CanDeleteOwn && customer.CreatedByUserId == Model.CurrentUserId);

                        <article class="customer-card customer-item"
                                 data-search="@($"{customer.FullName} {customer.Email} {customer.PhoneNumber} {customer.Address} {createdText} {updatedText}")"
                                 data-fullname="@customer.FullName"
                                 data-email="@customer.Email"
                                 data-phone="@customer.PhoneNumber"
                                 data-address="@customer.Address"
                                 data-created="@createdText"
                                 data-updated="@updatedText">

                            @if (!string.IsNullOrWhiteSpace(customer.ImageUrl))
                            {
                                <img src="@customer.ImageUrl" class="customer-image" alt="@customer.FullName" />
                            }
                            else
                            {
                                <div class="customer-placeholder">
                                    @customer.FullName.Substring(0, 1).ToUpper()
                                </div>
                            }

                            <div>
                                <div class="customer-name">@customer.FullName</div>
                                <div class="muted-text">@customer.Email</div>
                                <div class="muted-text">@customer.PhoneNumber</div>
                                <div class="muted-text">@customer.Address</div>

                                <div class="date-row">
                                    Created: @createdText
                                    @if (!string.IsNullOrWhiteSpace(updatedText))
                                    {
                                        <span> / Updated: @updatedText</span>
                                    }
                                </div>
                            </div>

                            @if (canUpdateThisCustomer || canDeleteThisCustomer)
                            {
                                <div>
                                    <button type="button" class="menu-button customer-menu-button">
                                        ☰
                                    </button>

                                    <div class="customer-menu">
                                        @if (canUpdateThisCustomer)
                                        {
                                            <a asp-controller="Customers"
                                               asp-action="Edit"
                                               asp-route-id="@customer.Id">
                                                Edit
                                            </a>
                                        }

                                        @if (canDeleteThisCustomer)
                                        {
                                            <form asp-controller="Customers"
                                                  asp-action="Delete"
                                                  asp-route-id="@customer.Id"
                                                  method="post">
                                                <button type="submit">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        @if (Model.CanViewAccessPermissions)
        {
            <section id="permissionsTab" class="tab-content-panel">
                <div class="permission-panel">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-1">Access Permissions</h4>
                            <p class="text-muted mb-0">
                                Manage who can view, create, update and delete customer records.
                            </p>
                        </div>
                    </div>

                    @if (TempData["PermissionSuccess"] is not null)
                    {
                        <div class="alert alert-success">
                            @TempData["PermissionSuccess"]
                        </div>
                    }

                    @if (TempData["PermissionError"] is not null)
                    {
                        <div class="alert alert-danger">
                            @TempData["PermissionError"]
                        </div>
                    }

                    @if (!Model.PermissionPage.Users.Any())
                    {
                        <div class="alert alert-info">
                            No users found.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Customers" asp-action="Index" method="get" class="mb-4">
                            <label class="form-label">Select employee/user</label>

                            <div class="d-flex gap-2">
                                <select name="selectedUserId" class="form-select" style="max-width: 420px;">
                                    @foreach (var user in Model.PermissionPage.Users)
                                    {
                                        if (user.Id == Model.PermissionPage.SelectedUserId)
                                        {
                                            <option value="@user.Id" selected>
                                                @user.FullName (@user.UserName)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@user.Id">
                                                @user.FullName (@user.UserName)
                                            </option>
                                        }
                                    }
                                </select>

                                <button type="submit" class="btn btn-outline-primary">
                                    Load Permissions
                                </button>
                            </div>
                        </form>

                        <form asp-controller="Customers" asp-action="SavePermissions" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="UserId" value="@Model.PermissionPage.SelectedUserId" />
                            <input type="hidden" name="ModuleName" value="Customers" />

                            <div class="table-responsive">
                                <table class="table table-hover bg-white align-middle">
                                    <thead>
                                        <tr>
                                            <th>Action</th>
                                            <th style="width: 260px;">Access Level</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @for (var i = 0; i < Model.PermissionPage.Actions.Count; i++)
                                        {
                                            var actionName = Model.PermissionPage.Actions[i];

                                            var existingPermission = Model.PermissionPage.Permissions
                                                .FirstOrDefault(permission => permission.ActionName == actionName);

                                            var accessLevel = existingPermission?.AccessLevel ?? 0;

                                            <tr>
                                                <td>
                                                    <strong>@actionName</strong>

                                                    <input type="hidden"
                                                           name="Permissions[@i].ActionName"
                                                           value="@actionName" />

                                                    <input type="hidden"
                                                           name="Permissions[@i].UserId"
                                                           value="@Model.PermissionPage.SelectedUserId" />

                                                    <input type="hidden"
                                                           name="Permissions[@i].ModuleName"
                                                           value="Customers" />
                                                </td>

                                                <td>
                                                    <select name="Permissions[@i].AccessLevel" class="form-select">
                                                        @if (accessLevel == 0)
                                                        {
                                                            <option value="0" selected>None</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="0">None</option>
                                                        }

                                                        @if (actionName == "Create")
                                                        {
                                                            if (accessLevel == 2)
                                                            {
                                                                <option value="2" selected>Allowed</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="2">Allowed</option>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (accessLevel == 1)
                                                            {
                                                                <option value="1" selected>Own records</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="1">Own records</option>
                                                            }

                                                            if (accessLevel == 2)
                                                            {
                                                                <option value="2" selected>All records</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="2">All records</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>

                                                <td class="text-muted">
                                                    @if (actionName == "View")
                                                    {
                                                        <span>Controls whether the user can see customer records.</span>
                                                    }
                                                    else if (actionName == "Create")
                                                    {
                                                        <span>Controls whether the user can create new customer records.</span>
                                                    }
                                                    else if (actionName == "Update")
                                                    {
                                                        <span>Controls whether the user can edit own or all customer records.</span>
                                                    }
                                                    else if (actionName == "Delete")
                                                    {
                                                        <span>Controls whether the user can delete own or all customer records.</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Permissions
                            </button>
                        </form>
                    }
                </div>
            </section>
        }
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/erp-advanced-filter.js"></script>

    <script>
        initializeAdvancedFilter({
        storageKey: "erp_customer_saved_filters",
        pinnedKey: "erp_customer_pinned_filter",
        itemSelector: ".customer-item",
        pageSelector: "#customerPage",
        defaultPlaceholder: "Search customer name, email, phone, address or date",
        fields: [
        {
        key: "quick",
        inputId: "quickSearch",
        dataKey: "search"
        },
        {
        key: "fullName",
        inputId: "filterFullName",
        dataKey: "fullname"
        },
        {
        key: "email",
        inputId: "filterEmail",
        dataKey: "email"
        },
        {
        key: "phone",
        inputId: "filterPhone",
        dataKey: "phone"
        },
        {
        key: "address",
        inputId: "filterAddress",
        dataKey: "address"
        },
        {
        key: "created",
        inputId: "filterCreated",
        dataKey: "created"
        },
        {
        key: "updated",
        inputId: "filterUpdated",
        dataKey: "updated"
        }
        ]
        });

        const customerPage = document.getElementById("customerPage");
        const kanbanButton = document.getElementById("kanbanButton");
        const listButton = document.getElementById("listButton");

        kanbanButton?.addEventListener("click", () => {
        customerPage.classList.remove("list-view");
        kanbanButton.className = "btn btn-dark";
        listButton.className = "btn btn-outline-secondary";
        });

        listButton?.addEventListener("click", () => {
        customerPage.classList.add("list-view");
        listButton.className = "btn btn-dark";
        kanbanButton.className = "btn btn-outline-secondary";
        });

        document.querySelectorAll(".customer-menu-button").forEach(button => {
        button.addEventListener("click", function () {
        const menu = this.parentElement.querySelector(".customer-menu");
        menu.style.display = menu.style.display === "block" ? "none" : "block";
        });
        });

        document.querySelectorAll(".module-tab").forEach(tab => {
        tab.addEventListener("click", function () {
        const targetId = this.dataset.tabTarget;

        document.querySelectorAll(".module-tab").forEach(item => {
        item.classList.remove("active");
        });

        document.querySelectorAll(".tab-content-panel").forEach(panel => {
        panel.classList.remove("active");
        });

        this.classList.add("active");
        document.getElementById(targetId).classList.add("active");
        });
        });
    </script>
</body>
</html>