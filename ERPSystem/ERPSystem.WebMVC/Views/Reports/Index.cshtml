@model ERPSystem.WebMVC.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Reports";
}

<h3 class="mb-3">Reports</h3>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Total Sales Amount</p>
                <h4>@Model.TotalSalesAmount</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Total Purchase Amount</p>
                <h4>@Model.TotalPurchaseAmount</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Unpaid Invoice Amount</p>
                <h4>@Model.TotalUnpaidInvoiceAmount</h4>
            </div>
        </div>
    </div>
</div>