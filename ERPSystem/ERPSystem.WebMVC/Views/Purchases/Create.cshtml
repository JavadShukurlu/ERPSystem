@model ERPSystem.WebMVC.ViewModels.Purchases.CreatePurchaseViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Purchase";
}

<div class="erp-page">
    <div class="erp-page-header">
        <div>
            <a asp-controller="Purchases" asp-action="Index" class="btn btn-outline-secondary erp-apps-btn">
                Back
            </a>

            <div class="erp-breadcrumb">
                ERP System / Purchases / Create
            </div>

            <h1>Create Purchase</h1>
            <p>Create a purchase order and increase stock quantities.</p>
        </div>

        <button type="submit" form="purchaseForm" class="btn btn-primary erp-create-btn">
            Save Purchase
        </button>
    </div>

    @if (ViewBag.Error is not null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form id="purchaseForm"
          asp-controller="Purchases"
          asp-action="Create"
          method="post"
          class="erp-form-card">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="erp-form-grid">
            <div class="erp-form-group">
                <label>Supplier</label>
                <select asp-for="SupplierId" asp-items="Model.Suppliers" class="form-select">
                    <option value="">Select supplier</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger small"></span>
            </div>

            <div class="erp-form-group">
                <label>Purchase Date</label>
                <input asp-for="PurchaseDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
            </div>
        </div>

        <div class="erp-items-section">
            <div class="erp-items-header">
                <div>
                    <h2>Purchase Items</h2>
                    <p>Select products, warehouses and quantities.</p>
                </div>

                <button type="button" id="addPurchaseItem" class="btn btn-outline-primary">
                    Add Item
                </button>
            </div>

            <div id="purchaseItems">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <div class="erp-item-row">
                        <div class="erp-form-group">
                            <label>Product</label>
                            <select asp-for="Items[i].ProductId" asp-items="Model.Items[i].Products" class="form-select purchase-product">
                                <option value="">Select product</option>
                            </select>
                            <span asp-validation-for="Items[i].ProductId" class="text-danger small"></span>
                        </div>

                        <div class="erp-form-group">
                            <label>Warehouse</label>
                            <select asp-for="Items[i].WarehouseId" asp-items="Model.Items[i].Warehouses" class="form-select">
                                <option value="">Select warehouse</option>
                            </select>
                            <span asp-validation-for="Items[i].WarehouseId" class="text-danger small"></span>
                        </div>

                        <div class="erp-form-group">
                            <label>Quantity</label>
                            <input asp-for="Items[i].Quantity" type="number" min="1" class="form-control purchase-quantity" />
                            <span asp-validation-for="Items[i].Quantity" class="text-danger small"></span>
                        </div>

                        <div class="erp-form-group">
                            <label>Unit Price</label>
                            <input asp-for="Items[i].UnitPrice" type="number" step="0.01" min="0" class="form-control purchase-price" />
                            <span asp-validation-for="Items[i].UnitPrice" class="text-danger small"></span>
                        </div>

                        <div class="erp-form-group">
                            <label>Total</label>
                            <input type="text" class="form-control purchase-line-total" readonly value="0.00" />
                        </div>

                        <button type="button" class="erp-remove-item">
                            x
                        </button>
                    </div>
                }
            </div>

            <div class="erp-purchase-summary">
                <span>Total Amount</span>
                <strong id="purchaseGrandTotal">0.00</strong>
            </div>
        </div>

        <div class="erp-form-actions">
            <button type="submit" class="btn btn-primary">
                Save Purchase
            </button>

            <a asp-controller="Purchases" asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const purchaseItems = document.getElementById("purchaseItems");
            const addButton = document.getElementById("addPurchaseItem");
            const grandTotal = document.getElementById("purchaseGrandTotal");

            function recalculate() {
                let total = 0;

                document.querySelectorAll(".erp-item-row").forEach(row => {
                    const quantity = Number(row.querySelector(".purchase-quantity")?.value || 0);
                    const price = Number(row.querySelector(".purchase-price")?.value || 0);
                    const lineTotal = quantity * price;

                    const lineTotalInput = row.querySelector(".purchase-line-total");
                    if (lineTotalInput) {
                        lineTotalInput.value = lineTotal.toFixed(2);
                    }

                    total += lineTotal;
                });

                grandTotal.textContent = total.toFixed(2);
            }

            function reindexRows() {
                document.querySelectorAll(".erp-item-row").forEach((row, index) => {
                    row.querySelectorAll("select, input").forEach(input => {
                        if (!input.name) {
                            return;
                        }

                        input.name = input.name.replace(/Items\[\d+\]/, `Items[${index}]`);
                        input.id = input.id.replace(/Items_\d+__/, `Items_${index}__`);
                    });
                });
            }

            addButton?.addEventListener("click", function () {
                const firstRow = document.querySelector(".erp-item-row");
                const clone = firstRow.cloneNode(true);

                clone.querySelectorAll("select").forEach(select => {
                    select.selectedIndex = 0;
                });

                clone.querySelectorAll("input").forEach(input => {
                    if (input.classList.contains("purchase-quantity")) {
                        input.value = 1;
                    } else {
                        input.value = "0";
                    }
                });

                purchaseItems.appendChild(clone);
                reindexRows();
                recalculate();
            });

            purchaseItems?.addEventListener("input", function (event) {
                if (event.target.classList.contains("purchase-quantity") ||
                    event.target.classList.contains("purchase-price")) {
                    recalculate();
                }
            });

            purchaseItems?.addEventListener("click", function (event) {
                if (!event.target.classList.contains("erp-remove-item")) {
                    return;
                }

                const rows = document.querySelectorAll(".erp-item-row");

                if (rows.length === 1) {
                    return;
                }

                event.target.closest(".erp-item-row").remove();
                reindexRows();
                recalculate();
            });

            recalculate();
        });
    </script>
}