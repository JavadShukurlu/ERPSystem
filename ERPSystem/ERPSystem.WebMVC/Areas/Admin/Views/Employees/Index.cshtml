@model List<ERPSystem.WebMVC.ViewModels.Employees.EmployeeViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Employees</h2>
        <p class="text-muted mb-0">Manage company employees.</p>
    </div>

    <a asp-area="Admin" asp-controller="Employees" asp-action="Create" class="btn btn-primary">
        Add Employee
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No employees found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr>
                <th style="width: 80px;">Photo</th>
                <th>Employee</th>
                <th>Department</th>
                <th>Position</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Salary</th>
                <th style="width: 190px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(employee.ImageUrl))
                        {
                            <img src="@employee.ImageUrl"
                                 alt="@employee.FullName"
                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 50%;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                 style="width: 48px; height: 48px; border-radius: 50%;">
                                @employee.FirstName.Substring(0, 1)@employee.LastName.Substring(0, 1)
                            </div>
                        }
                    </td>

                    <td>
                        <strong>@employee.FullName</strong>
                        <div class="text-muted small">
                            Hired: @employee.HireDate.ToString("dd MMM yyyy")
                        </div>
                    </td>

                    <td>@employee.DepartmentName</td>
                    <td>@employee.Position</td>
                    <td>@employee.Email</td>
                    <td>@employee.PhoneNumber</td>
                    <td>@employee.Salary.ToString("0.00")</td>

                    <td>
                        <a asp-area="Admin"
                           asp-controller="Employees"
                           asp-action="Edit"
                           asp-route-id="@employee.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Employees"
                              asp-action="Delete"
                              asp-route-id="@employee.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this employee?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}