@model ERPSystem.WebMVC.ViewModels.Stocks.CreateStockViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Stock";
}

<h2 class="mb-4">Create Stock</h2>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-area="Admin" asp-controller="Stocks" asp-action="Create" method="post" class="bg-white p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Product</label>
        <select asp-for="ProductId" asp-items="Model.Products" class="form-select">
            <option value="">Select product</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Warehouse</label>
        <select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select">
            <option value="">Select warehouse</option>
        </select>
        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" type="number" min="0" />
        <span asp-validation-for="Quantity" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-area="Admin" asp-controller="Stocks" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>