@model List<ERPSystem.WebMVC.ViewModels.Stocks.StockViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Stocks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Stocks</h2>
        <p class="text-muted mb-0">Manage product quantities by warehouse.</p>
    </div>

    <a asp-area="Admin" asp-controller="Stocks" asp-action="Create" class="btn btn-primary">
        Add Stock
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No stock records found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Warehouse</th>
                <th>Quantity</th>
                <th style="width: 190px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stock in Model)
            {
                <tr>
                    <td>
                        <strong>@stock.ProductName</strong>
                    </td>
                    <td>@stock.WarehouseName</td>
                    <td>
                        @if (stock.Quantity <= 5)
                        {
                            <span class="badge bg-danger">@stock.Quantity Low</span>
                        }
                        else if (stock.Quantity <= 20)
                        {
                            <span class="badge bg-warning text-dark">@stock.Quantity Medium</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@stock.Quantity Available</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Stocks"
                           asp-action="Edit"
                           asp-route-id="@stock.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Stocks"
                              asp-action="Delete"
                              asp-route-id="@stock.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this stock record?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}