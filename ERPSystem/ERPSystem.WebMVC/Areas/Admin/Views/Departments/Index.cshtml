@model List<ERPSystem.WebMVC.ViewModels.Departments.DepartmentViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Departments</h2>
        <p class="text-muted mb-0">Manage company departments.</p>
    </div>

    <a asp-area="Admin" asp-controller="Departments" asp-action="Create" class="btn btn-primary">
        Add Department
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No departments found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Departments"
                           asp-action="Edit"
                           asp-route-id="@department.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Departments"
                              asp-action="Delete"
                              asp-route-id="@department.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this department?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}