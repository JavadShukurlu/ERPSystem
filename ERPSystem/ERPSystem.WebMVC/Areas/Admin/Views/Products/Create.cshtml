@model ERPSystem.WebMVC.ViewModels.Products.CreateProductViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Product";
}

<h3 class="mb-3">Create Product</h3>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="bg-white p-4 shadow-sm">

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">SKU</label>
        <input asp-for="SKU" class="form-control" />
        <span asp-validation-for="SKU" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Product Image</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="ImageFile" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Purchase Price</label>
        <input asp-for="PurchasePrice" class="form-control" />
        <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Sale Price</label>
        <input asp-for="SalePrice" class="form-control" />
        <span asp-validation-for="SalePrice" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="0">Select category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>