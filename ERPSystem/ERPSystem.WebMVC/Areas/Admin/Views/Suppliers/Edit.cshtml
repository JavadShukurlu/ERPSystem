@model ERPSystem.WebMVC.ViewModels.Suppliers.UpdateSupplierViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Supplier";
}

<h3 class="mb-3">Edit Supplier</h3>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-area="Admin"
      asp-controller="Suppliers"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data"
      class="bg-white p-4 shadow-sm">

    <input asp-for="Id" type="hidden" />
    <input asp-for="LogoUrl" type="hidden" />

    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
    {
        <div class="mb-3">
            <label class="form-label">Current Logo</label>
            <div>
                <img src="@Model.LogoUrl"
                     alt="@Model.CompanyName"
                     style="width:96px;height:96px;object-fit:cover;border-radius:10px;" />
            </div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Change Logo</label>
        <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="LogoFile" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Company Name</label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Contact Name</label>
        <input asp-for="ContactName" class="form-control" />
        <span asp-validation-for="ContactName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Phone Number</label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-area="Admin" asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>