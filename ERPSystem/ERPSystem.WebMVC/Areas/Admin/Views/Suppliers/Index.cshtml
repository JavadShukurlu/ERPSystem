@model List<ERPSystem.WebMVC.ViewModels.Suppliers.SupplierViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Suppliers</h3>
        <p class="text-muted mb-0">Manage supplier records.</p>
    </div>

    <a asp-area="Admin" asp-controller="Suppliers" asp-action="Create" class="btn btn-primary">
        Add Supplier
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No suppliers found.
    </div>
}
else
{
    <table class="table table-hover bg-white align-middle">
        <thead>
            <tr>
                <th>Logo</th>
                <th>Company</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Phone</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(supplier.LogoUrl))
                        {
                            <img src="@supplier.LogoUrl"
                                 alt="@supplier.CompanyName"
                                 style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <span class="text-muted">No logo</span>
                        }
                    </td>
                    <td>@supplier.CompanyName</td>
                    <td>@supplier.ContactName</td>
                    <td>@supplier.Email</td>
                    <td>@supplier.PhoneNumber</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Suppliers"
                           asp-action="Edit"
                           asp-route-id="@supplier.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Suppliers"
                              asp-action="Delete"
                              asp-route-id="@supplier.Id"
                              method="post"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}