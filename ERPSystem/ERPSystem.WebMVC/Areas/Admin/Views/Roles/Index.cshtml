@model List<ERPSystem.WebMVC.ViewModels.Roles.RoleViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Roles</h2>
        <p class="text-muted mb-0">Manage system roles and permissions.</p>
    </div>

    <a asp-area="Admin" asp-controller="Roles" asp-action="Create" class="btn btn-primary">
        Add Role
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No roles found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Role Id</th>
                <th style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>
                        <strong>@role.Name</strong>
                    </td>
                    <td class="text-muted small">@role.Id</td>
                    <td>
                        <form asp-area="Admin"
                              asp-controller="Roles"
                              asp-action="Delete"
                              asp-route-id="@role.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this role?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}