@model ERPSystem.WebMVC.ViewModels.Roles.CreateRoleViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Role";
}

<h2 class="mb-4">Create Role</h2>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-area="Admin" asp-controller="Roles" asp-action="Create" method="post" class="bg-white p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Role Name</label>
        <input asp-for="Name" class="form-control" placeholder="Example: Manager" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>