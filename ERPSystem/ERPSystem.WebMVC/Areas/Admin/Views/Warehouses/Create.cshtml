@model ERPSystem.WebMVC.ViewModels.Warehouses.CreateWarehouseViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Warehouse";
}

<h2 class="mb-4">Create Warehouse</h2>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-area="Admin" asp-controller="Warehouses" asp-action="Create" method="post" class="bg-white p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Warehouse Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Location</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-area="Admin" asp-controller="Warehouses" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>