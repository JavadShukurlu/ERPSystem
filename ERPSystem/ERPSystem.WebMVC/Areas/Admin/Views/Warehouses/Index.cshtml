@model List<ERPSystem.WebMVC.ViewModels.Warehouses.WarehouseViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Warehouses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Warehouses</h2>
        <p class="text-muted mb-0">Manage storage locations and warehouse data.</p>
    </div>

    <a asp-area="Admin" asp-controller="Warehouses" asp-action="Create" class="btn btn-primary">
        Add Warehouse
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No warehouses found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Description</th>
                <th style="width: 190px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var warehouse in Model)
            {
                <tr>
                    <td>
                        <strong>@warehouse.Name</strong>
                    </td>
                    <td>@warehouse.Location</td>
                    <td>@warehouse.Description</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Warehouses"
                           asp-action="Edit"
                           asp-route-id="@warehouse.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Warehouses"
                              asp-action="Delete"
                              asp-route-id="@warehouse.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this warehouse?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}