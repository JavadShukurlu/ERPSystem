@model ERPSystem.WebMVC.ViewModels.SystemSettings.SystemSettingViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "System Settings";
}

<div class="mb-4">
    <h2 class="mb-1">System Settings</h2>
    <p class="text-muted mb-0">Manage company information and ERP configuration.</p>
</div>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (ViewBag.Success is not null)
{
    <div class="alert alert-success">
        @ViewBag.Success
    </div>
}

<form asp-area="Admin"
      asp-controller="SystemSettings"
      asp-action="Index"
      method="post"
      class="bg-white p-4 shadow-sm">

    <input asp-for="Id" type="hidden" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" />
            <span asp-validation-for="CompanyName" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Company Email</label>
            <input asp-for="CompanyEmail" class="form-control" />
            <span asp-validation-for="CompanyEmail" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Company Phone</label>
            <input asp-for="CompanyPhone" class="form-control" />
            <span asp-validation-for="CompanyPhone" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Currency</label>
            <select asp-for="Currency" class="form-select">
                <option value="AZN">AZN</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="TRY">TRY</option>
            </select>
            <span asp-validation-for="Currency" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Tax Percent</label>
            <input asp-for="TaxPercent" class="form-control" type="number" step="0.01" min="0" max="100" />
            <span asp-validation-for="TaxPercent" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Invoice Prefix</label>
            <input asp-for="InvoicePrefix" class="form-control" />
            <span asp-validation-for="InvoicePrefix" class="text-danger small"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Low Stock Threshold</label>
            <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" />
            <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
        </div>

        <div class="col-md-12 mb-3">
            <label class="form-label">Address</label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Settings
    </button>
</form>