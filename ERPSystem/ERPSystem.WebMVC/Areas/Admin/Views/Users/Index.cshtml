@model List<ERPSystem.WebMVC.ViewModels.Users.UserViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Users</h2>
        <p class="text-muted mb-0">Manage system users and their access roles.</p>
    </div>

    <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary">
        Add User
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Roles</th>
                <th style="width: 240px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <strong>@user.FullName</strong>
                    </td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Any())
                        {
                            foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No role</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Users"
                           asp-action="AssignRoles"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-primary">
                            Roles
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Users"
                              asp-action="Delete"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}