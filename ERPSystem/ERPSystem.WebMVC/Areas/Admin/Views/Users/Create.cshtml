@model ERPSystem.WebMVC.ViewModels.Users.CreateUserViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create User";
}

<h2 class="mb-4">Create User</h2>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-area="Admin" asp-controller="Users" asp-action="Create" method="post" class="bg-white p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Username</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Roles</label>

        @if (!Model.AvailableRoles.Any())
        {
            <div class="alert alert-warning mb-0">
                No roles found. Please create roles first.
            </div>
        }
        else
        {
            foreach (var role in Model.AvailableRoles)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Roles"
                           value="@role.Value"
                           id="role_@role.Value" />

                    <label class="form-check-label" for="role_@role.Value">
                        @role.Text
                    </label>
                </div>
            }
        }
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>