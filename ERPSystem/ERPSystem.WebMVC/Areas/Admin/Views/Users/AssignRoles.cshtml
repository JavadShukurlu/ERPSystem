@model ERPSystem.WebMVC.ViewModels.Users.AssignUserRolesViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Assign Roles";
}

<h2 class="mb-1">Assign Roles</h2>
<p class="text-muted mb-4">@Model.FullName (@Model.UserName)</p>

@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-area="Admin" asp-controller="Users" asp-action="AssignRoles" method="post" class="bg-white p-4 shadow-sm">
    <input asp-for="UserId" type="hidden" />
    <input asp-for="FullName" type="hidden" />
    <input asp-for="UserName" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Roles</label>

        @if (!Model.AvailableRoles.Any())
        {
            <div class="alert alert-warning mb-0">
                No roles found.
            </div>
        }
        else
        {
            foreach (var role in Model.AvailableRoles)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="Roles"
                           value="@role.Value"
                           id="role_@role.Value"
                           checked="@role.Selected" />

                    <label class="form-check-label" for="role_@role.Value">
                        @role.Text
                    </label>
                </div>
            }
        }
    </div>

    <button type="submit" class="btn btn-primary">
        Save Roles
    </button>

    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>