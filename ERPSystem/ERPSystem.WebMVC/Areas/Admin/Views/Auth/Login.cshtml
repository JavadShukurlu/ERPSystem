@model ERPSystem.WebMVC.ViewModels.Auth.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow border-0" style="width: 420px;">
            <div class="card-body p-4">
                <h4 class="mb-1">Admin Panel</h4>
                <p class="text-muted mb-4">Sign in with administrator account</p>

                @if (ViewBag.Error is not null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-area="Admin" asp-controller="Auth" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label">Username or Email</label>
                        <input asp-for="UserNameOrEmail" class="form-control" />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        Login to Admin
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-area="" asp-controller="Auth" asp-action="Login" class="text-decoration-none">
                        Back to workspace login
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>